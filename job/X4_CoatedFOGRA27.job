    <Engine EngineType="Inspire Messenger">
      <FormatConfig Name="Default">
        <General SendingMode="0" EmailMode="0" LandingMode="0" GenerateTextVersion="False" URLMode="2" URLMode4SMS="2" ThreadCount="4" RasterizeFlows="True" CenterDocument="False" BackgroundColor="#FFFFFF" KeepWordsTogether="True" Gradient="False" PageSpacing="0" SendAutomatically="False" LandingPageFontName="Arial" LandingPageFontSize="8" LandingPageTextColor="#999999" LandingPageTextBold="False" LandingPageTextItalic="False"/>
