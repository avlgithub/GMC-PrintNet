<?xml version="1.0" encoding="UTF-8"?>
<ProductionConfig Version="10.0.90.0">
  <EngineConfigs>
    <Engine EngineType="Dynamic Communications">
      <FormatConfig Name="Default">
        <GenerateExternalResources>False</GenerateExternalResources>
        <mGenerateResourcesTo>%n_files</mGenerateResourcesTo>
        <HTMLPathToResources>%n_files</HTMLPathToResources>
        <UseOriginalResourceNames>False</UseOriginalResourceNames>
        <MinifySource>True</MinifySource>
        <ForceUpdateComponents>False</ForceUpdateComponents>
        <Fonts>
          <FontAlternatives/>
        </Fonts>
      </FormatConfig>
      <DriverConfig DriverConfigType="File" Name="Default">
        <OutputFileName>%n%g.%e</OutputFileName>
        <Split>True</Split>
        <SplitBySize>False</SplitBySize>
        <SplitSize>1000000</SplitSize>
        <JobName>%n</JobName>
        <Comment/>
      </DriverConfig>
    </Engine>
    <Engine EngineType="IPDS">
      <FormatConfig Name="Default">
        <General>
          <PrinterResolutionForPositioning>240</PrinterResolutionForPositioning>
          <MaxIpdsDataSizeInKB>8</MaxIpdsDataSizeInKB>
          <MaxPageSegmentsCount>127</MaxPageSegmentsCount>
          <MaxOverlaysCount>254</MaxOverlaysCount>
          <MaxFontsCount>128</MaxFontsCount>
          <PagesPerAcknowledge>1</PagesPerAcknowledge>
          <GraphicsSupport>None</GraphicsSupport>
          <WhiteColorProcessing>Text</WhiteColorProcessing>
          <OutputColors>Black and white</OutputColors>
          <AssignIPDSColorsToIndex>
            <SpotColor SpotColor="0" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="1" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="2" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="3" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="4" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="5" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="6" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="7" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="8" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="9" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="10" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="11" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="12" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="13" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="14" IPDSColor="DefaultColor"/>
            <SpotColor SpotColor="15" IPDSColor="DefaultColor"/>
          </AssignIPDSColorsToIndex>
          <ReportUndefinedCharacters>True</ReportUndefinedCharacters>
          <ReportPrintOutsitePage>True</ReportPrintOutsitePage>
          <ReportAllOther>True</ReportAllOther>
          <HiglightException>True</HiglightException>
          <UseRelativeMetricPrefered>False</UseRelativeMetricPrefered>
          <DoubleByteFonts>False</DoubleByteFonts>
          <Compression>False</Compression>
          <UseIOImageCmd>True</UseIOImageCmd>
          <StackReceivedPages>False</StackReceivedPages>
          <SplitOverlaysForNipson>none</SplitOverlaysForNipson>
          <GrayscaleImage>
            <GrayscaleImageSupportAllowed>False</GrayscaleImageSupportAllowed>
            <GrayscaleFormat>Uncompressed</GrayscaleFormat>
            <JpegCompressionQuality>80</JpegCompressionQuality>
            <ConvertToGrayscale>16M color images, PDF, EPS</ConvertToGrayscale>
          </GrayscaleImage>
          <JogPageCountAOS>0</JogPageCountAOS>
          <ResolutionForFontsImages>0</ResolutionForFontsImages>
          <FullColorImageFormat>Uncompressed</FullColorImageFormat>
          <RestartSeparatorPagesCount>0</RestartSeparatorPagesCount>
          <AssignHighlightToOCA/>
